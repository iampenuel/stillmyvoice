# Server-only. Copy to a private, ignored .env; never use VITE_ prefixes.
# Live cloud requests remain OFF until credentials and account conditions are verified.
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
SMV_CLOUD_MODE=disabled
SMV_ELEVENLABS_CREDITS_CONFIRMED=false
SMV_GEMINI_FREE_TIER_CONFIRMED=false
SMV_GEMINI_MODEL=gemini-3.5-flash-lite
