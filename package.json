{
  "name": "stillmyvoice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "test": "node --test tests/*.test.mts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "api": "node server/index.mts",
    "prepare:gaze": "node scripts/prepare-gaze-assets.mts",
    "predev": "npm run prepare:gaze",
    "prebuild": "npm run prepare:gaze",
    "build:demo": "tsc --noEmit && VITE_SMV_RELEASE_MODE=frontend-demo vite build --mode frontend-demo",
    "preview:demo": "VITE_SMV_RELEASE_MODE=frontend-demo vite preview --mode frontend-demo --host 127.0.0.1 --port 4173 --strictPort"
  },
  "dependencies": {
    "@google/genai": "3.3.0",
    "@mediapipe/tasks-vision": "0.10.18",
    "@realeye-io/webcam-eyetracker-light-open": "1.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
